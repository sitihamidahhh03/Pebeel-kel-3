<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardStatus"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/tvModeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mode: Manual"
                android:textColor="#2D3A29"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status Tanah"
                android:textColor="#2D3A29"
                android:textSize="13sp"
                android:alpha="0.6" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Kering"
                android:textColor="#2D3A29"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Container untuk status aktuator (Hanya muncul saat Manual) -->
            <LinearLayout
                android:id="@+id/layoutStatusManual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <!-- Indikator Pompa -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="12dp">
                    <View
                        android:id="@+id/dotPompa"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_dot_status" />
                    <TextView
                        android:id="@+id/tvStatusPompa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Siram"
                        android:textSize="11sp"
                        android:layout_marginStart="4dp"
                        android:textColor="#757575"/>
                </LinearLayout>

                <!-- Indikator Kipas -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <View
                        android:id="@+id/dotKipas"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_dot_status" />
                    <TextView
                        android:id="@+id/tvStatusKipas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kipas"
                        android:textSize="11sp"
                        android:layout_marginStart="4dp"
                        android:textColor="#757575"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:progress="100"
                android:progressDrawable="@drawable/circle_background" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:progress="43"
                android:progressDrawable="@drawable/circle_progress"
                android:progressTint="#8BAE66" />

            <TextView
                android:id="@+id/tvPercentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="43%"
                android:textColor="#2D3A29"
                android:textSize="16sp"
                android:textStyle="bold" />
        </FrameLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>