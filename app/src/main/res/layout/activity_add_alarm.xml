<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF2E1"
    android:orientation="vertical">

    <!-- Header dengan Tombol Kembali (Aktif) -->
    <include layout="@layout/layout_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pilih Waktu"
            android:textColor="#3E4E35"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- Form Input Waktu Kotak Panjang (Persegi) -->
        <TextView
            android:id="@+id/tv_time"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@android:color/white"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="20:42"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:drawableEnd="@android:drawable/ic_menu_edit"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Pengingat"
            android:textColor="#3E4E35"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- Form Input Label Kotak Panjang (Persegi) -->
        <EditText
            android:id="@+id/et_label"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@android:color/white"
            android:hint="Contoh: Siram Cabai Pagi"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#000000"
            android:textSize="16sp"
            android:inputType="textCapSentences"
            android:importantForAutofill="no"
            android:elevation="2dp"
            android:layout_marginBottom="40dp" />

        <!-- Tombol SIMPAN ALARM (Hijau Gelap, Bentuk Kotak) -->
        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="#424E36"
            android:text="SIMPAN ALARM"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            app:cornerRadius="0dp" />

        <!-- Tombol BATAL (Hijau Gelap, Bentuk Kotak) -->
        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="#424E36"
            android:text="BATAL"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:cornerRadius="0dp" />

    </LinearLayout>
</LinearLayout>
