<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8F2">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvGrafikTitle"
                android:text="Grafik Minggu Ini"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/syam_green_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="Data kelembaban tanah real-time"
                android:textSize="14sp"
                android:textColor="#888888"
                android:layout_marginBottom="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:singleSelection="true"
                app:checkedButton="@+id/btnWeek">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWeek"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Minggu"
                    android:textColor="@color/syam_green_dark"
                    app:strokeColor="@color/syam_green_dark"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMonth"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bulan"
                    android:textColor="@color/syam_green_dark"
                    app:strokeColor="@color/syam_green_dark"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnYear"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tahun"
                    android:textColor="@color/syam_green_dark"
                    app:strokeColor="@color/syam_green_dark"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/barChart"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginBottom="32dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card_grafik"
                android:padding="20dp"
                android:gravity="center_vertical"
                android:elevation="2dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_height="wrap_content">
                    <TextView
                        android:text="Rata-Rata"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@color/syam_green_dark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/tvLabelRange"
                        android:text="Minggu Ini"
                        android:textSize="14sp"
                        android:textColor="#888888"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChart"
                    android:layout_width="100dp"
                    android:layout_height="100dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvDetailTitle"
                android:text="Detail Data Terkumpul"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/syam_green_dark"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvNoData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Belum ada riwayat data detail untuk waktu ini."
                android:textColor="#888888"
                android:gravity="center"
                android:padding="20dp"
                android:visibility="gone"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDetailData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:background="@drawable/bg_card_grafik"
                android:padding="8dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>