<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.MoNiKa" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/syam_green_dark</item>
        <item name="colorPrimaryVariant">@color/syam_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/syam_green_medium</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Latar belakang aplikasi -->
        <item name="android:windowBackground">@color/syam_green_light</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/syam_green_dark</item>
        <item name="colorError">#B00020</item>
        <item name="colorOnError">@color/white</item>

        <!-- Perbaikan Crash Button -->
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.MaterialComponents.Button.OutlinedButton</item>
        <item name="textAppearanceButton">@style/TextAppearance.MaterialComponents.Button</item>

        <item name="android:statusBarColor">@color/syam_green_dark</item>
    </style>

    <style name="Theme.MoNiKa" parent="Base.Theme.MoNiKa" />

    <!-- Style Jam (TimePicker) - DIPERBAIKI (TOMBOL PASTI MUNCUL) -->
    <style name="CustomTimePickerTheme" parent="Theme.MaterialComponents.Light.Dialog">
        <!-- Warna utama tombol OKE/BATAL dan selektor jam -->
        <item name="android:colorAccent">@color/syam_green_dark</item>
        <item name="colorAccent">@color/syam_green_dark</item>

        <!-- PAKSA Latar Belakang Putih Solid pada Jendela -->
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorBackground">@android:color/white</item>
        <item name="android:windowIsTranslucent">false</item>

        <!-- Warna Header Jam -->
        <item name="android:headerBackground">@color/syam_green_dark</item>
        <item name="android:numbersTextColor">@color/black</item>
        <item name="android:numbersSelectorColor">@color/syam_green_medium</item>

        <!-- PERBAIKAN: Paksa warna teks tombol agar Hijau Gelap dan Muncul -->
        <item name="android:buttonBarPositiveButtonStyle">@style/CustomTimerButtonStyle</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/CustomTimerButtonStyle</item>
    </style>

    <!-- Style khusus untuk teks tombol agar kontras dan tebal -->
    <style name="CustomTimerButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/syam_green_dark</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>
    <style name="BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>